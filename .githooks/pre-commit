#!/bin/sh
# 提交前压缩暂存的相册照片：缩到长边 2560px、重新编码、剥掉 EXIF（含 GPS 定位），
# 压完自动重新暂存。没有暂存照片时会立刻退出，不影响其他提交。
#
# 由 core.hooksPath 指向本目录后生效，npm install 时会自动配置（见 package.json 的 prepare）。
# 手动配置：git config core.hooksPath .githooks
# 临时跳过：git commit --no-verify

# 只做“有没有动到相册目录”的快速判断，具体哪些格式要处理交给脚本决定，
# 避免格式列表在这里和 scripts/gallery-config.js 之间产生分歧。
if [ -z "$(git diff --cached --name-only --diff-filter=ACM -- public/static/images/gallery)" ]; then
  exit 0
fi

echo "[pre-commit] 压缩暂存的相册照片…"
if ! node scripts/compress-gallery.js --staged; then
  echo "[pre-commit] 压缩失败，已中止提交。修复后重试，或用 git commit --no-verify 跳过。" >&2
  exit 1
fi
